{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": "src"
  },
  "include": ["src/server/**/*", "src/agentable.*"],
  "exclude": ["node_modules", "dist"]
}
